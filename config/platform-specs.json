  "placements": {
    "meta-feed-square": {
      "platform": "meta",
      "surface": "feed",
      "asset_type": "image",
      "ratio": "1:1",
      "width": 1080,
      "height": 1080,
      "status": "working-recommendation",
      "safe_inset_percent": 6,
      "copy_lines_max": 3,
      "notes": ["Meta supports square photos in Feed.", "Prefer 4:5 when one portrait Feed asset can be supplied."]
    },
    "meta-feed-portrait": {
      "platform": "meta",
      "surface": "feed",
      "asset_type": "image",
      "ratio": "4:5",
      "width": 1080,
      "height": 1350,
      "status": "official-ratio-working-size",
      "safe_inset_percent": 6,
      "copy_lines_max": 3,
      "notes": ["Meta recommends 4:5 for Feed.", "Keep the product as the primary focal point and on-image copy short."]
    },
    "meta-stories": {
      "platform": "meta",
      "surface": "stories",
      "asset_type": "image-or-video",
      "ratio": "9:16",
      "width": 1080,
      "height": 1920,
      "status": "official-ratio-working-size",
      "safe_inset_percent": 10,
      "critical_content_zone": {"x": 64, "y": 128, "width": 952, "height": 1200},
      "default_embedded_overlays": {"logo": false, "product_title": false, "price_offer": false, "cta": false},
      "copy_lines_max": 3,
      "notes": ["Stories are full-screen vertical placements.", "Keep the hero visual, callouts, and essential text inside the critical-content zone.", "Background and decoration may extend outside the critical-content zone.", "Open Ads defaults to no embedded logo, price, offer, or CTA for 9:16 placements unless the brief explicitly requires one."]
    },
    "meta-reels": {
      "platform": "meta",
      "surface": "reels",
      "asset_type": "video-preferred",
      "ratio": "9:16",
      "width": 1080,
      "height": 1920,
      "status": "official-ratio-working-size",
      "safe_inset_percent": 10,
      "critical_content_zone": {"x": 64, "y": 128, "width": 952, "height": 1200},
      "default_embedded_overlays": {"logo": false, "product_title": false, "price_offer": false, "cta": false},
      "copy_lines_max": 3,
      "notes": ["Keep the hero visual, callouts, and essential messages inside the critical-content zone.", "Background and decoration may extend outside the critical-content zone.", "Open Ads defaults to no embedded logo, price, offer, or CTA for 9:16 placements unless the brief explicitly requires one.", "Use audio for video when rights permit."]
    },
    "google-pmax-landscape": {
      "platform": "google",
      "surface": "performance-max",
      "asset_type": "image",
      "ratio": "1.91:1",
      "width": 1200,
      "height": 628,
      "minimum_width": 600,
      "minimum_height": 314,
      "max_file_mb": 5,
      "required": true,
      "recommended_count": 4,
      "maximum_count": 20,
      "safe_inset_percent": 10,
      "notes": ["Keep critical content within the center 80%.", "Supply at least one image without text or graphic overlays for this ratio."]
    },
    "google-pmax-square": {
      "platform": "google",
      "surface": "performance-max",
      "asset_type": "image",
      "ratio": "1:1",
      "width": 1200,
      "height": 1200,
      "minimum_width": 300,
      "minimum_height": 300,
      "max_file_mb": 5,
      "required": true,
      "recommended_count": 4,
      "maximum_count": 20,
      "safe_inset_percent": 10,
      "notes": ["Keep critical content within the center 80%.", "Supply at least one image without text or graphic overlays for this ratio."]
    },
    "google-pmax-portrait": {
      "platform": "google",
      "surface": "performance-max",
      "asset_type": "image",
      "ratio": "4:5",
      "width": 960,
      "height": 1200,
      "minimum_width": 480,
      "minimum_height": 600,
      "max_file_mb": 5,
