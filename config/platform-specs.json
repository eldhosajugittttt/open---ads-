    },
    "google-pmax-logo-square": {
      "platform": "google",
      "surface": "performance-max",
      "asset_type": "logo",
      "ratio": "1:1",
      "width": 1200,
      "height": 1200,
      "minimum_width": 128,
      "minimum_height": 128,
      "max_file_mb": 5,
      "required": true,
      "recommended_count": 1,
      "maximum_count": 5,
      "safe_inset_percent": 10,
      "notes": ["Avoid a predominantly white logo on transparency because it may render on white."]
    },
    "google-pmax-logo-landscape": {
      "platform": "google",
