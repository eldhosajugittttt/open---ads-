{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ads.local/schemas/ad-ir.schema.json",
  "title": "Open Ads editable design IR",
  "type": "object",
  "required": ["version", "frame", "tokens", "layers", "review"],
  "properties": {
    "version": { "const": "1.0" },
    "frame": {
      "type": "object",
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "background": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "colors": { "type": "object", "additionalProperties": { "type": "string" } },
        "fonts": { "type": "object", "additionalProperties": { "type": "string" } },
        "spacing": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "kind", "box", "confidence", "editable"],
        "properties": {
          "id": { "type": "string" },
          "role": {
            "enum": ["BACKGROUND", "PRODUCT_IMAGE", "LOGO", "HEADLINE", "SUBHEADLINE", "PRICE", "OFFER", "CTA", "LEGAL", "DECORATION", "GROUP"]
          },
          "kind": { "enum": ["frame", "text", "image", "rectangle", "vector", "group"] },
          "box": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "minimum": 0 },
              "height": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "text": { "type": "string" },
          "asset": { "type": "string" },
          "font": {
            "type": "object",
            "properties": {
              "family": { "type": "string" },
              "style": { "type": "string" },
              "size": { "type": "number" },
              "line_height": { "type": "number" },
              "letter_spacing": { "type": "number" },
              "match_type": { "enum": ["exact", "available-substitute", "inferred"] }
            },
            "additionalProperties": false
          },
          "fill": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "editable": { "type": "boolean" },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["required", "issues"],
      "properties": {
        "required": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
