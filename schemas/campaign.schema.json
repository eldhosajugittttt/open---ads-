{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ads.local/schemas/campaign.schema.json",
  "title": "Open Ads campaign",
  "type": "object",
  "required": ["campaign_id", "client", "concept", "approvals", "targets"],
  "properties": {
    "campaign_id": { "type": "string", "minLength": 1 },
    "client": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
    "concept": {
      "type": "object",
      "required": ["name", "headline", "cta", "product_asset"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "subheadline": { "type": "string" },
        "cta": { "type": "string", "minLength": 1 },
        "offer": { "type": "string" },
        "price": { "type": "string" },
        "legal_copy": { "type": "string" },
        "destination_url": { "type": "string", "format": "uri" },
        "product_asset": { "type": "string", "minLength": 1 },
        "logo_asset": { "type": "string" },
        "generated_product_scene": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "pmax_copy": {
      "type": "object",
      "properties": {
        "headlines": { "type": "array", "items": { "type": "string" } },
        "long_headlines": { "type": "array", "items": { "type": "string" } },
        "descriptions": { "type": "array", "items": { "type": "string" } },
        "business_name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "required": ["concept", "product_truth", "offer", "legal", "publishing"],
      "properties": {
        "concept": { "$ref": "#/$defs/status" },
        "product_truth": { "$ref": "#/$defs/status" },
        "offer": { "$ref": "#/$defs/status" },
        "legal": { "$ref": "#/$defs/status" },
        "publishing": { "$ref": "#/$defs/status" }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["approved", "pending", "rejected", "not-applicable"]
    }
  },
  "additionalProperties": false
}
